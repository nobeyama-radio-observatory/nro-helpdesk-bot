# /srv/nro-bot/secrets.env に置く（chmod 600、所有者 nrobot）。リポジトリには入れない。
ANTHROPIC_API_KEY=
DISCORD_TOKEN=
# 答えるチャンネルの ID（カンマ区切り）。Discord の開発者モードでチャンネルを右クリック →「ID をコピー」
NRO_BOT_CHANNEL_IDS=
# 記録がないときにメンションするロールの ID（任意）
NRO_BOT_HELPDESK_ROLE_ID=
# 以下は任意（既定値）
#NRO_BOT_MODEL=claude-sonnet-5-5
#NRO_BOT_EFFORT=medium
#NRO_BOT_DAILY_LIMIT=100
# 一人あたりの上限。0 は制限なし
#NRO_BOT_PER_USER_DAILY_LIMIT=0
